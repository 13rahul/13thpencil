# Live site. Keep this on production so canonical, OG and sitemap stay on-domain.
SITE_URL="https://13thpencil.com"

# MySQL — create this database first, then run npm run db:setup
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/thirteenth_pencil"

# Random string, at least 32 characters. Required for admin login cookies.
AUTH_SECRET="replace-with-a-long-random-secret"

# Seeded on first `npm run db:seed` only (existing users are not overwritten)
ADMIN_EMAIL="hello@13thpencil.com"
ADMIN_PASSWORD="ChangeMe13!"

# Brief wizard notifications
LEAD_NOTIFY_EMAIL="prabu@13thpencil.com"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="hello@13thpencil.com"
SMTP_PASS=""
SMTP_FROM="13th Pencil <hello@13thpencil.com>"
