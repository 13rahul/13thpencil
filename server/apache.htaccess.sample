# 13th Pencil — sample Apache configuration for 13thpencil.com
# Rename to .htaccess and place in the web root, or fold into the vhost.
# Static site: no application runtime required.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---- force HTTPS and the apex domain ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://13thpencil.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.13thpencil\.com$ [NC]
  RewriteRule ^ https://13thpencil.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- security headers ----
# The site loads no third-party scripts. Adding analytics later means adding
# that host to the Content-Security-Policy below.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # HTML always revalidated so deploys appear immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---- compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

# ---- caching for fingerprintable assets ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 30 days"
  ExpiresByType application/javascript   "access plus 30 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

# ---- correct types for the fonts, if you switch to self-hosting ----
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
